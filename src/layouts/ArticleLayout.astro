---
import BaseLayout from './BaseLayout.astro';
import Support from '../components/Support.astro';
import Newsletter from '../components/Newsletter.astro';
import SeriesNav from '../components/SeriesNav.astro';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props {
  article: CollectionEntry<'articles'>;
  headings?: MarkdownHeading[];
}
const { article, headings = [] } = Astro.props;
const { title, subtitle, description, readingTime, updated } = article.data;
const base = import.meta.env.BASE_URL;
const toc = headings.filter((h) => h.depth === 2);
const fmtDate = updated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — learninghub`} description={description} footerSupport={false}>
  <div class="progress" aria-hidden="true"><span id="progress-bar"></span></div>

  <article class="wrap">
    <header class="article-head">
      <a class="back" href={`${base}#map`}>◀ Back to the map</a>
      <p class="coord">{article.data.series ? `${article.data.series} line` : 'Deep-dive'}</p>
      <h1>{title}</h1>
      <p class="subtitle">{subtitle}</p>
      <div class="byline">
        <span class="meta-inline">{readingTime}</span>
        <span class="sep" aria-hidden="true">·</span>
        <span class="meta-inline">Updated {fmtDate}</span>
        <span class="sep" aria-hidden="true">·</span>
        <span class="meta-inline">Living document</span>
        <button id="copy-article" class="copy-btn" type="button" aria-label="Copy article content to clipboard">
          <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
          <span class="copy-label">Copy for Substack</span>
        </button>
      </div>
    </header>

    {article.data.series && <SeriesNav article={article} />}

    <hr class="rule head-rule" />

    <div class="layout">
      <div class="prose" id="article-body">
        <slot />
      </div>

      <aside class="side">
        {toc.length > 0 && (
          <nav class="toc-nav" aria-label="Table of contents">
            <p class="side-label">On this page</p>
            <ol class="toc">
              {toc.map((h) => (
                <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>
              ))}
            </ol>
          </nav>
        )}

        <div class="side-block">
          <Newsletter variant="card" />
        </div>
        <div class="side-block">
          <Support variant="card" />
        </div>
      </aside>
    </div>
  </article>

  <script>
    const bar = document.getElementById('progress-bar');
    const onScroll = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      if (bar) bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
    };
    document.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
    if (links.length) {
      const heads = links
        .map((l) => document.getElementById(l.dataset.toc || ''))
        .filter((el): el is HTMLElement => !!el);
      const setActive = (id: string) =>
        links.forEach((l) => l.classList.toggle('active', l.dataset.toc === id));
      const obs = new IntersectionObserver(
        (entries) => {
          const vis = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (vis[0]) setActive(vis[0].target.id);
        },
        { rootMargin: '-10% 0px -70% 0px', threshold: 0 }
      );
      heads.forEach((h) => obs.observe(h));
    }

    // ---- Copy article content (rich HTML) for pasting into Substack etc. ----
    const copyBtn = document.getElementById('copy-article');
    const body = document.getElementById('article-body');
    if (copyBtn && body) {
      const label = copyBtn.querySelector('.copy-label');

      const buildHtml = () => {
        const clone = body.cloneNode(true) as HTMLElement;
        clone.querySelectorAll('a.anchor').forEach((a) => a.remove());
        clone.querySelectorAll('[data-no-copy]').forEach((el) => el.remove());
        clone.querySelectorAll('.callout').forEach((c) => {
          const lbl = c.querySelector('.callout-label')?.textContent?.trim() || 'Note';
          const inner = c.querySelector('.callout-body')?.innerHTML || '';
          const bq = document.createElement('blockquote');
          bq.innerHTML = `<p><strong>${lbl}</strong></p>${inner}`;
          c.replaceWith(bq);
        });
        clone.querySelectorAll('*').forEach((el) => {
          el.removeAttribute('class');
          [...el.attributes].forEach((at) => {
            if (at.name.startsWith('data-')) el.removeAttribute(at.name);
          });
        });
        return { html: clone.innerHTML, text: clone.textContent?.trim() || '' };
      };

      const flash = (msg: string) => {
        if (label) label.textContent = msg;
        copyBtn.classList.add('copied');
        setTimeout(() => {
          if (label) label.textContent = 'Copy for Substack';
          copyBtn.classList.remove('copied');
        }, 2000);
      };

      copyBtn.addEventListener('click', async () => {
        const { html, text } = buildHtml();
        try {
          await navigator.clipboard.write([
            new ClipboardItem({
              'text/html': new Blob([html], { type: 'text/html' }),
              'text/plain': new Blob([text], { type: 'text/plain' }),
            }),
          ]);
          flash('Copied!');
        } catch (e) {
          try {
            await navigator.clipboard.writeText(text);
            flash('Copied text');
          } catch (e2) {
            flash('Copy failed');
          }
        }
      });
    }
  </script>

  <style>
    .progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 210; }
    .progress span { display: block; height: 100%; width: 0; background: var(--accent); }

    .article-head { padding: 2.8rem 0 0; max-width: 52rem; }
    .back {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin-bottom: 1.6rem;
    }
    .back:hover { color: var(--accent-ink); }
    .coord {
      margin: 0 0 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .article-head h1 { font-size: clamp(2.1rem, 5vw, 3.2rem); line-height: 1.08; margin: 0; }
    .subtitle {
      font-size: clamp(1.1rem, 2.4vw, 1.4rem);
      line-height: 1.45;
      color: var(--ink-soft);
      margin: 1rem 0 0;
      max-width: 44rem;
    }

    .byline {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.4rem 0.7rem;
      margin-top: 1.4rem;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      color: var(--ink-faint);
    }
    .byline .sep { color: var(--line-strong); }
    .copy-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      margin-left: auto;
      padding: 0.32rem 0.6rem;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.04em;
      color: var(--ink-soft);
      background: transparent;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: color 0.15s var(--ease-out), border-color 0.15s var(--ease-out);
    }
    .copy-btn svg { fill: none; stroke: currentColor; stroke-width: 1.8; }
    .copy-btn:hover { color: var(--accent-ink); border-color: var(--accent); }
    .copy-btn.copied { color: var(--accent); border-color: var(--accent); }

    .head-rule { margin: 1.8rem 0 0; }

    /* ---- Prose column + editorial margin rail ---- */
    .layout { margin: 2.2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
    @media (min-width: 64rem) {
      .layout { grid-template-columns: minmax(0, 1fr) 16rem; gap: 3.5rem; align-items: start; }
    }
    .side { display: flex; flex-direction: column; gap: 2rem; }
    @media (min-width: 64rem) {
      .side { position: sticky; top: 6rem; }
    }
    .side-label {
      font-family: var(--font-mono);
      font-size: 0.64rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-faint);
      margin: 0 0 0.7rem;
    }
    .side-block { padding-top: 1.4rem; border-top: 1px solid var(--line); }

    /* ---- TOC ---- */
    .toc { list-style: none; margin: 0; padding: 0; counter-reset: toc; display: flex; flex-direction: column; }
    .toc li { counter-increment: toc; }
    .toc a {
      display: block;
      padding: 0.34rem 0 0.34rem 0.8rem;
      border-left: 1px solid var(--line);
      color: var(--ink-faint);
      font-size: 0.86rem;
      line-height: 1.4;
      transition: color 0.15s var(--ease-out), border-color 0.15s var(--ease-out);
    }
    .toc a::before {
      content: counter(toc, decimal-leading-zero) '  ';
      font-family: var(--font-mono);
      font-size: 0.72em;
      opacity: 0.7;
    }
    .toc a:hover { color: var(--accent-ink); }
    .toc a.active { color: var(--accent-ink); border-left-color: var(--accent); }
    .toc a.active::before { color: var(--accent); opacity: 1; }
    @media (max-width: 64rem) { .toc-nav { display: none; } }

    /* ---- Prose ---- */
    .prose { min-width: 0; max-width: 66ch; font-size: 1.12rem; line-height: 1.72; }
    .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 1.2rem 0; }
    .prose :global(> p:first-of-type) {
      font-size: 1.28rem;
      line-height: 1.55;
      color: var(--ink);
    }
    .prose :global(> p:first-of-type)::first-letter {
      initial-letter: 2;
      -webkit-initial-letter: 2;
      font-family: var(--font-body);
      font-weight: 600;
      color: var(--accent);
      margin-right: 0.6rem;
    }
    .prose :global(h2) {
      font-size: clamp(1.5rem, 3.2vw, 1.9rem);
      margin: 3rem 0 0.6rem;
      padding-top: 1.8rem;
      border-top: 1px solid var(--line);
      scroll-margin-top: 6rem;
    }
    /* station-dot marker where each section rule begins — echoes the map */
    .prose :global(h2)::before {
      content: '';
      position: absolute;
      top: -5px; left: 0;
      width: 9px; height: 9px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 0 4px var(--paper);
    }
    .prose :global(h3) { font-size: 1.3rem; margin: 2rem 0 0.4rem; scroll-margin-top: 6rem; }
    .prose :global(h2), .prose :global(h3) { position: relative; }
    .prose :global(h2 > a.anchor), .prose :global(h3 > a.anchor) {
      position: absolute; left: -1.3rem; color: var(--accent);
      opacity: 0; text-decoration: none; transition: opacity 0.15s var(--ease-out);
    }
    .prose :global(h2:hover > a.anchor), .prose :global(h3:hover > a.anchor) { opacity: 0.55; }
    .prose :global(h2 + p), .prose :global(h3 + p) { margin-top: 0.5rem; }
    .prose :global(ul), .prose :global(ol) { padding-left: 1.3rem; }
    .prose :global(li) { margin: 0.4rem 0; }
    .prose :global(li)::marker { color: var(--accent); }

    .prose :global(blockquote) {
      margin: 1.8rem 0;
      padding: 0.4rem 0 0.4rem 1.3rem;
      border-left: 3px solid var(--accent);
      color: var(--ink-soft);
      font-size: 1.14rem;
      font-style: italic;
    }
    .prose :global(blockquote p) { margin: 0.4rem 0; }

    .prose :global(pre) {
      margin: 1.7rem 0;
      padding: 1.1rem 1.2rem;
      border-radius: var(--radius);
      border: 1px solid var(--line);
      background: var(--paper-sunk) !important;
      overflow-x: auto;
      font-size: 0.86rem;
      line-height: 1.65;
    }
    .prose :global(pre code) { background: none; border: none; padding: 0; white-space: pre; font-variant-numeric: normal; }
    .prose :global(.astro-code), .prose :global(.astro-code span) {
      color: var(--shiki-light); background-color: transparent;
    }
    :global(:root[data-theme='dark']) .prose :global(.astro-code),
    :global(:root[data-theme='dark']) .prose :global(.astro-code span) {
      color: var(--shiki-dark);
      font-style: var(--shiki-dark-font-style);
      font-weight: var(--shiki-dark-font-weight);
    }

    .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.8rem 0; font-size: 0.95rem; }
    .prose :global(th), .prose :global(td) {
      text-align: left; padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--line); vertical-align: top;
    }
    .prose :global(thead th) {
      border-bottom: 2px solid var(--line-strong);
      font-family: var(--font-mono);
      font-size: 0.66rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }
    .prose :global(hr) { border: none; border-top: 3px double var(--line-strong); margin: 2.8rem auto; width: 40%; }
  </style>
</BaseLayout>
