---
import BaseLayout from './BaseLayout.astro';
import Panel from '../components/Panel.astro';
import Support from '../components/Support.astro';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props {
  article: CollectionEntry<'articles'>;
  headings?: MarkdownHeading[];
}
const { article, headings = [] } = Astro.props;
const { title, subtitle, description, readingTime, updated } = article.data;
const base = import.meta.env.BASE_URL;
const toc = headings.filter((h) => h.depth === 2);
const fmtDate = updated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — learninghub`} description={description} footerSupport={false}>
  <div class="progress" aria-hidden="true"><span id="progress-bar"></span></div>

  <article class="wrap">
    <header class="article-head">
      <a class="back" href={`${base}#topics`}>← All topics</a>
      <h1>{title}</h1>
      <p class="subtitle">{subtitle}</p>
    </header>

    <div class="layout">
      <div class="main">
        <Panel title={`${article.id}.md`} mono meta="readonly" padded={false}>
          <div class="prose">
            <slot />
          </div>
        </Panel>
      </div>

      <aside class="side">
        <Panel title="Article" meta="info" padded={false}>
          <table class="meta-table">
            <tbody>
              <tr><th>read</th><td>{readingTime}</td></tr>
              <tr><th>updated</th><td>{fmtDate}</td></tr>
              <tr><th>status</th><td>Living document</td></tr>
            </tbody>
          </table>
        </Panel>

        {toc.length > 0 && (
          <Panel title="On this page" class="toc-panel">
            <nav aria-label="Table of contents">
              <ol class="toc">
                {toc.map((h) => (
                  <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>
                ))}
              </ol>
            </nav>
          </Panel>
        )}

        <Support variant="card" />
      </aside>
    </div>
  </article>

  <script>
    const bar = document.getElementById('progress-bar');
    const onScroll = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      if (bar) bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
    };
    document.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
    if (links.length) {
      const heads = links
        .map((l) => document.getElementById(l.dataset.toc || ''))
        .filter((el): el is HTMLElement => !!el);
      const setActive = (id: string) =>
        links.forEach((l) => l.classList.toggle('active', l.dataset.toc === id));
      const obs = new IntersectionObserver(
        (entries) => {
          const vis = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (vis[0]) setActive(vis[0].target.id);
        },
        { rootMargin: '-10% 0px -70% 0px', threshold: 0 }
      );
      heads.forEach((h) => obs.observe(h));
    }
  </script>

  <style>
    .progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 45; }
    .progress span { display: block; height: 100%; width: 0; background: var(--accent); }

    .article-head { padding: 2.5rem 0 0; max-width: 46rem; }
    .back { display: inline-block; font-size: 0.88rem; color: var(--ink-faint); margin-bottom: 1.4rem; }
    .back:hover { color: var(--accent-ink); }
    .article-head h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0.7rem 0 0; }
    .subtitle {
      font-size: clamp(1.05rem, 2.4vw, 1.3rem);
      line-height: 1.5;
      color: var(--ink-soft);
      margin: 0.8rem 0 0;
      max-width: 42rem;
    }

    /* ---- Two-column app layout ---- */
    .layout { margin: 2rem 0; display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
    @media (min-width: 64rem) {
      .layout { grid-template-columns: minmax(0, 1fr) 19rem; gap: 1.75rem; align-items: start; }
    }
    .side { display: flex; flex-direction: column; gap: 1.25rem; }
    @media (min-width: 64rem) {
      .side { position: sticky; top: 5rem; }
    }

    /* ---- TOC ---- */
    .toc { list-style: none; margin: 0; padding: 0; counter-reset: toc; display: flex; flex-direction: column; gap: 0.1rem; }
    .toc li { counter-increment: toc; }
    .toc a {
      display: block;
      padding: 0.32rem 0 0.32rem 0.75rem;
      border-left: 2px solid var(--line);
      color: var(--ink-faint);
      font-size: 0.86rem;
      line-height: 1.35;
      transition: color 0.15s ease, border-color 0.15s ease;
    }
    .toc a::before {
      content: counter(toc, decimal-leading-zero) '  ';
      font-family: var(--mono);
      font-size: 0.78em;
      opacity: 0.7;
    }
    .toc a:hover { color: var(--accent-ink); }
    .toc a.active { color: var(--accent-ink); border-left-color: var(--accent); font-weight: 550; }
    .toc a.active::before { color: var(--accent); opacity: 1; }
    @media (max-width: 64rem) { .toc-panel { display: none; } }

    /* ---- Prose ---- */
    .prose { padding: 1.4rem 1.6rem 1.8rem; min-width: 0; }
    @media (max-width: 40rem) { .prose { padding: 1.2rem; } }
    .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 1.1rem 0; }
    .prose :global(> p:first-of-type) { font-size: 1.12rem; color: var(--ink-soft); }
    .prose :global(h2) {
      font-size: clamp(1.4rem, 3.2vw, 1.7rem);
      margin: 2.6rem 0 0.5rem;
      padding-top: 1.6rem;
      border-top: 1px solid var(--line);
      scroll-margin-top: 5rem;
    }
    .prose :global(h3) { font-size: 1.18rem; margin: 1.9rem 0 0.4rem; scroll-margin-top: 5rem; }
    .prose :global(h2), .prose :global(h3) { position: relative; }
    .prose :global(h2 > a.anchor), .prose :global(h3 > a.anchor) {
      position: absolute; left: -1.2rem; color: var(--accent);
      opacity: 0; text-decoration: none; transition: opacity 0.15s ease;
    }
    .prose :global(h2:hover > a.anchor), .prose :global(h3:hover > a.anchor) { opacity: 0.55; }
    .prose :global(h2 + p), .prose :global(h3 + p) { margin-top: 0.4rem; }
    .prose :global(ul), .prose :global(ol) { padding-left: 1.3rem; }
    .prose :global(li) { margin: 0.35rem 0; }
    .prose :global(li)::marker { color: var(--accent); }
    .prose :global(strong) { font-weight: 650; color: var(--ink); }

    .prose :global(blockquote) {
      margin: 1.6rem 0;
      padding: 0.9rem 1.1rem;
      border: 1px solid var(--line);
      border-left: 3px solid var(--accent);
      border-radius: var(--radius-sm);
      background: var(--paper-sunk);
      color: var(--ink-soft);
      font-size: 1.02rem;
    }
    .prose :global(blockquote p) { margin: 0; }

    .prose :global(pre) {
      margin: 1.5rem 0;
      padding: 1rem 1.15rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--line);
      background: var(--paper-sunk) !important;
      overflow-x: auto;
      font-size: 0.85rem;
      line-height: 1.6;
    }
    .prose :global(pre code) { background: none; border: none; padding: 0; white-space: pre; }
    .prose :global(.astro-code), .prose :global(.astro-code span) {
      color: var(--shiki-light); background-color: transparent;
    }
    :global(:root[data-theme='dark']) .prose :global(.astro-code),
    :global(:root[data-theme='dark']) .prose :global(.astro-code span) {
      color: var(--shiki-dark);
      font-style: var(--shiki-dark-font-style);
      font-weight: var(--shiki-dark-font-weight);
    }

    .prose :global(table) { width: 100%; border-collapse: collapse; margin: 1.6rem 0; font-size: 0.92rem; }
    .prose :global(th), .prose :global(td) {
      text-align: left; padding: 0.6rem 0.8rem; border: 1px solid var(--line); vertical-align: top;
    }
    .prose :global(thead th) {
      background: var(--paper-sunk);
      font-family: var(--mono);
      font-size: 0.7rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }
    .prose :global(hr) { border: none; border-top: 1px solid var(--line); margin: 2.5rem 0; }
  </style>
</BaseLayout>
