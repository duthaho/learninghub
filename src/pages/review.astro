---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

// Flatten every article's recall cards into one deck. Card ids are stable as
// long as the article's recall array keeps its order.
const deck = articles.flatMap((a) =>
  (a.data.recall ?? []).map((c, i) => ({
    id: `${a.id}#${i}`,
    q: c.q,
    a: c.a,
    series: a.data.series ?? 'Standalone',
    article: a.data.title,
    href: `${base}${a.id}/`,
  }))
);
const seriesNames = [...new Set(deck.map((c) => c.series))];
---

<BaseLayout
  title="Review — learninghub"
  description="A spaced-repetition review queue built from every deep-dive's recall cards. Answer from memory, grade yourself, and the queue schedules the next pass."
>
  <section class="wrap review-page">
    <header class="review-head">
      <p class="eyebrow">Review queue · spaced repetition</p>
      <h1>Keep it, don't re-read it.</h1>
      <p class="lede">
        Every deep-dive ends with recall cards. This queue schedules them:
        answer from memory, grade yourself honestly, and cards you miss come
        back sooner. Progress lives in your browser — nothing leaves it.
      </p>
    </header>

    <noscript>
      <p class="noscript">The review queue needs JavaScript. The cards themselves
      are at the end of each article on the <a href={base}>map</a>.</p>
    </noscript>

    <div class="review-panel" id="review-app" hidden>
      <div class="controls">
        <label class="filter">
          <span class="filter-label">Line</span>
          <select id="series-filter">
            <option value="">All series</option>
            {seriesNames.map((s) => <option value={s}>{s}</option>)}
          </select>
        </label>
        <p class="stats" id="stats" aria-live="polite"></p>
      </div>

      <div class="stage" id="stage">
        <div class="flashcard" id="card" hidden>
          <p class="card-source"><a id="card-link" href="#"><span id="card-series"></span> · <span id="card-article"></span></a></p>
          <p class="card-side-label" id="side-label">Question</p>
          <p class="card-text" id="card-text"></p>
          <div class="actions">
            <button class="btn" id="reveal" type="button">Reveal answer</button>
            <div class="grades" id="grades" hidden>
              <button class="btn-ghost grade-again" id="grade-again" type="button">✗ Missed it</button>
              <button class="btn grade-good" id="grade-good" type="button">✓ Got it</button>
            </div>
          </div>
        </div>
        <div class="empty" id="empty" hidden>
          <p class="empty-mark" aria-hidden="true">◉</p>
          <p class="empty-title" id="empty-title"></p>
          <p class="empty-sub" id="empty-sub"></p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline type="application/json" id="deck-data" set:html={JSON.stringify(deck)} />

  <script>
    // Leitner-style scheduler: box 0 (new/missed) → reviewed again this session;
    // each "got it" promotes a box, with due dates 1 / 3 / 7 / 21 / 60 days out.
    const INTERVALS = [0, 1, 3, 7, 21, 60];
    const KEY = 'lh-review-v1';
    const DAY = 86_400_000;

    type Card = { id: string; q: string; a: string; series: string; article: string; href: string };
    type State = Record<string, { box: number; due: number }>;

    const deck: Card[] = JSON.parse(document.getElementById('deck-data')!.textContent!);

    const load = (): State => {
      try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; }
    };
    const save = (s: State) => { try { localStorage.setItem(KEY, JSON.stringify(s)); } catch {} };

    const state = load();
    const now = () => Date.now();

    const el = (id: string) => document.getElementById(id)!;
    const app = el('review-app');
    app.hidden = false;

    const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const md = (s: string) => esc(s).replace(/`([^`]+)`/g, '<code>$1</code>');

    let filter = '';
    let queue: Card[] = [];
    let current: Card | null = null;
    let revealed = false;
    let doneThisSession = 0;

    const pool = () => (filter ? deck.filter((c) => c.series === filter) : deck);
    const isDue = (c: Card) => {
      const s = state[c.id];
      return !s || s.due <= now();
    };

    const buildQueue = () => {
      queue = pool().filter(isDue);
      // Oldest-due first, then shuffle lightly within new cards for variety.
      queue.sort((a, b) => (state[a.id]?.due ?? 0) - (state[b.id]?.due ?? 0));
    };

    const renderStats = () => {
      const p = pool();
      const due = p.filter(isDue).length;
      const seen = p.filter((c) => state[c.id]).length;
      el('stats').textContent =
        `${due} due · ${p.length - seen} new · ${p.length} cards` +
        (doneThisSession ? ` · ${doneThisSession} done` : '');
    };

    const show = () => {
      renderStats();
      const card = el('card');
      const empty = el('empty');
      current = queue[0] ?? null;
      if (!current) {
        card.hidden = true;
        empty.hidden = false;
        const p = pool();
        if (p.length === 0) {
          el('empty-title').textContent = 'No cards on this line yet.';
          el('empty-sub').textContent = 'Recall decks are being added series by series — check back soon.';
        } else {
          el('empty-title').textContent = 'All caught up.';
          el('empty-sub').textContent = 'Nothing due right now. Cards you graded come back on schedule — 1, 3, 7, 21, then 60 days.';
        }
        return;
      }
      empty.hidden = true;
      card.hidden = false;
      revealed = false;
      (el('card-link') as HTMLAnchorElement).href = current.href;
      el('card-series').textContent = current.series;
      el('card-article').textContent = current.article;
      el('side-label').textContent = 'Question';
      el('card-text').innerHTML = md(current.q);
      el('reveal').hidden = false;
      el('grades').hidden = true;
    };

    const reveal = () => {
      if (!current || revealed) return;
      revealed = true;
      el('side-label').textContent = 'Answer';
      el('card-text').innerHTML = md(current.a);
      el('reveal').hidden = true;
      el('grades').hidden = false;
      (el('grade-good') as HTMLButtonElement).focus();
    };

    const grade = (good: boolean) => {
      if (!current || !revealed) return;
      const prev = state[current.id]?.box ?? 0;
      const box = good ? Math.min(prev + 1, INTERVALS.length - 1) : 0;
      state[current.id] = { box, due: now() + INTERVALS[box] * DAY };
      save(state);
      doneThisSession++;
      queue.shift();
      if (!good) queue.push(current); // missed cards repeat this session
      show();
    };

    el('reveal').addEventListener('click', reveal);
    el('grade-good').addEventListener('click', () => grade(true));
    el('grade-again').addEventListener('click', () => grade(false));
    el('series-filter').addEventListener('change', (e) => {
      filter = (e.target as HTMLSelectElement).value;
      buildQueue();
      show();
    });

    document.addEventListener('keydown', (e) => {
      if (e.target instanceof HTMLSelectElement) return;
      if (e.key === ' ' || e.key === 'Enter') {
        if (current && !revealed) { e.preventDefault(); reveal(); }
      } else if (revealed && (e.key === '1' || e.key.toLowerCase() === 'x')) {
        grade(false);
      } else if (revealed && (e.key === '2' || e.key.toLowerCase() === 'g')) {
        grade(true);
      }
    });

    buildQueue();
    show();
  </script>

  <style>
    .review-page { padding: clamp(3rem, 7vw, 5rem) 0 4rem; }
    /* .btn/.grades set display:flex, which defeats the hidden attribute */
    .review-page [hidden] { display: none !important; }
    .review-head h1 {
      font-size: clamp(2.2rem, 4.6vw + 0.5rem, 3.6rem);
      line-height: 1.06;
      margin: 1rem 0 0;
      max-width: 16ch;
    }
    .lede {
      max-width: 44rem;
      font-size: clamp(1.05rem, 2vw, 1.22rem);
      line-height: 1.62;
      color: var(--ink-soft);
      margin: 1.3rem 0 0;
    }
    .noscript { margin-top: 2rem; color: var(--ink-soft); }

    .review-panel { margin-top: 2.6rem; border-top: 3px double var(--line-strong); }

    .controls {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.8rem 1.5rem;
      padding: 1rem 0;
      border-bottom: 1px solid var(--line);
    }
    .filter { display: inline-flex; align-items: center; gap: 0.6rem; }
    .filter-label {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }
    .filter select {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--ink);
      background: var(--paper);
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-sm);
      padding: 0.35rem 0.5rem;
    }
    .filter select:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 1px; }
    .stats {
      margin: 0 0 0 auto;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.06em;
      color: var(--ink-faint);
    }

    .stage { padding: 2.2rem 0; min-height: 18rem; }
    .flashcard { max-width: 42rem; }
    .card-source { margin: 0 0 1.4rem; }
    .card-source a {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-faint);
      text-decoration: none;
      border-bottom: 1px solid transparent;
    }
    .card-source a:hover { color: var(--accent-ink); border-bottom-color: var(--accent); }
    .card-source #card-series { color: var(--accent); }

    .card-side-label {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 0 0 0.6rem;
    }
    .card-text {
      font-size: clamp(1.25rem, 2.6vw, 1.55rem);
      line-height: 1.5;
      color: var(--ink);
      margin: 0 0 2rem;
      min-height: 4.6em;
    }
    .card-text :global(code) {
      font-family: var(--font-mono);
      font-size: 0.82em;
      background: var(--paper-sunk);
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      padding: 0.08em 0.3em;
    }

    .actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .grades { display: flex; gap: 0.8rem; flex-wrap: wrap; }
    .grade-again { color: oklch(58% 0.15 45); border-color: currentColor; }
    :global(:root[data-theme='dark']) .grade-again { color: oklch(74% 0.14 55); }

    .empty { max-width: 40rem; padding: 1rem 0; }
    .empty-mark { color: var(--accent); font-size: 1.6rem; margin: 0 0 0.8rem; }
    .empty-title {
      font-family: var(--font-display);
      font-weight: 600;
      letter-spacing: -0.02em;
      font-size: 1.6rem;
      margin: 0 0 0.5rem;
    }
    .empty-sub { color: var(--ink-soft); margin: 0; line-height: 1.6; }
  </style>
</BaseLayout>
