---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404 — learninghub" description="Page not found.">
  <section class="nf wrap">
    <p class="code">404</p>
    <h1>This page wandered off.</h1>
    <p class="msg">
      The link may be broken or the page moved. Let's get you back to something
      useful.
    </p>
    <div class="cta">
      <a class="btn" href={base}>Back home</a>
      <a class="btn-ghost" href={`${base}#map`}>Open the map</a>
    </div>
  </section>

  <style>
    .nf { max-width: 40rem; padding: clamp(3rem, 12vw, 7rem) 0; text-align: center; }
    .code {
      font-family: var(--mono);
      font-size: clamp(3rem, 14vw, 6rem);
      font-weight: 500;
      color: var(--accent);
      margin: 0;
      line-height: 1;
    }
    .nf h1 { font-size: clamp(1.6rem, 5vw, 2.4rem); margin: 1rem 0 0; }
    .msg { color: var(--ink-soft); font-size: 1.05rem; margin: 1rem auto 2rem; max-width: 32rem; }
    .cta { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; }
  </style>
</BaseLayout>
