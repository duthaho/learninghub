---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;

// Collapse multi-part series (frontmatter `series`) into one station; standalone
// articles are their own station. `part: 0` is the series cover (start-here
// guide), everything else is a numbered chapter.
const bySeries = new Map();
const standalone = [];
for (const a of articles) {
  if (a.data.series) {
    if (!bySeries.has(a.data.series)) bySeries.set(a.data.series, []);
    bySeries.get(a.data.series).push(a);
  } else {
    standalone.push(a);
  }
}

const entries = standalone.map((a) => ({ kind: 'article', order: a.data.order, article: a }));
for (const [name, parts] of bySeries) {
  parts.sort((x, y) => (x.data.part ?? 0) - (y.data.part ?? 0));
  const cover = parts.find((p) => (p.data.part ?? 0) === 0) ?? parts[0];
  const chapters = parts.filter((p) => p !== cover);
  entries.push({
    kind: 'series',
    order: Math.min(...parts.map((p) => p.data.order)),
    name,
    slug: name.toLowerCase(),
    cover,
    chapters,
    count: chapters.length,
  });
}
entries.sort((a, b) => a.order - b.order);

const upcoming = [
  { id: 'mysql', name: 'MySQL', subtitle: 'Indexes, transactions & the query planner' },
];

const stations = [
  ...entries.map((e) =>
    e.kind === 'article'
      ? { state: 'live', name: e.article.data.title, sub: e.article.data.subtitle,
          href: `${base}${e.article.id}/`, rt: e.article.data.readingTime, kind: 'deep-dive' }
      : { state: 'series', name: e.name, sub: e.cover.data.subtitle, slug: e.slug,
          cover: e.cover, chapters: e.chapters, count: e.count, kind: `${e.count}-part series` }
  ),
  ...upcoming.map((u) => ({ state: 'planned', name: u.name, sub: u.subtitle, kind: 'planned' })),
];

const nodeId = (i) => 'N' + String(i + 1).padStart(2, '0');
const partId = (n) => (n === 0 ? '★' : String(n).padStart(2, '0'));
---

<BaseLayout
  title="learninghub — a map of the backend systems you actually use"
  description="Deep-dives on the backend systems every engineer leans on — Redis, MySQL, Elasticsearch and more — laid out as a map. Written in public from real study notes."
>
  <section class="map-intro wrap">
    <p class="eyebrow">Node map · backend systems</p>
    <h1>Read the systems<br />as a <span class="accent">map</span> — not a list.</h1>
    <p class="lede">
      I learn one system at a time, down to where I can make design decisions and
      read other people's code. Each one becomes a station on this line — mental
      model first, gotchas included. Follow the track.
    </p>
    <div class="cta">
      <a class="btn" href="#map">Open the map</a>
      <a class="btn-ghost" href={`${base}about/`}>How this works</a>
    </div>
  </section>

  <section id="map" class="map wrap">
    <div class="legend">
      <span class="key"><i class="dot dot-live" aria-hidden="true"></i> deep-dive</span>
      <span class="key"><i class="dot dot-series" aria-hidden="true"></i> series</span>
      <span class="key"><i class="dot dot-planned" aria-hidden="true"></i> planned</span>
      <span class="legend-meta">{stations.length} nodes · {articles.length} articles</span>
    </div>

    <ol class="line plot" role="list">
      {stations.map((s, i) => (
        s.state === 'series' ? (
          <li class={`station station-series`}>
            <details class="series">
              <summary class="station-row">
                <span class="node"><span class="dot dot-series" aria-hidden="true"></span></span>
                <span class="station-body">
                  <span class="station-coord">{nodeId(i)} · {s.kind}</span>
                  <span class="station-title">{s.name}</span>
                  <span class="station-sub">{s.sub}</span>
                </span>
                <span class="station-end">
                  <span class="station-open">Trace line</span>
                  <span class="chev" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="15" height="15"><path d="M9 6l6 6-6 6"/></svg>
                  </span>
                </span>
              </summary>
              <ol class="branch" role="list">
                <li class="stop stop-cover">
                  <a href={`${base}${s.cover.id}/`}>
                    <span class="stop-node"><span class="stop-dot" aria-hidden="true">★</span></span>
                    <span class="stop-title">Start here — series guide</span>
                    <span class="stop-rt">{s.cover.data.readingTime}</span>
                    <span class="go" aria-hidden="true">→</span>
                  </a>
                </li>
                {s.chapters.map((c) => (
                  <li class="stop">
                    <a href={`${base}${c.id}/`}>
                      <span class="stop-node"><span class="stop-dot" aria-hidden="true">{partId(c.data.part)}</span></span>
                      <span class="stop-title">{c.data.title}</span>
                      <span class="stop-rt">{c.data.readingTime}</span>
                      <span class="go" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          </li>
        ) : s.state === 'live' ? (
          <li class="station station-live">
            <a class="station-row" href={s.href}>
              <span class="node"><span class="dot dot-live" aria-hidden="true"></span></span>
              <span class="station-body">
                <span class="station-coord">{nodeId(i)} · {s.kind}</span>
                <span class="station-title">{s.name}</span>
                <span class="station-sub">{s.sub}</span>
              </span>
              <span class="station-end">
                <span class="station-rt">{s.rt}</span>
                <span class="go" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ) : (
          <li class="station station-planned">
            <div class="station-row">
              <span class="node"><span class="dot dot-planned" aria-hidden="true"></span></span>
              <span class="station-body">
                <span class="station-coord">{nodeId(i)} · in progress</span>
                <span class="station-title">{s.name}</span>
                <span class="station-sub">{s.sub}</span>
              </span>
              <span class="station-end">
                <span class="station-rt">queued</span>
              </span>
            </div>
          </li>
        )
      ))}
    </ol>
  </section>

  <style>
    .map-intro { padding: clamp(3.5rem, 9vw, 6rem) 0 clamp(2rem, 5vw, 3rem); }
    .map-intro h1 {
      font-size: var(--text-display, clamp(2.6rem, 5.2vw + 1rem, 4.6rem));
      line-height: 1.04;
      margin: 1rem 0 0;
      max-width: 15ch;
    }
    .map-intro h1 .accent { color: var(--accent); }
    .lede {
      max-width: 42rem;
      font-size: clamp(1.1rem, 2.2vw, 1.28rem);
      line-height: 1.62;
      color: var(--ink-soft);
      margin: 1.5rem 0 2rem;
    }
    .cta { display: flex; gap: 0.8rem; flex-wrap: wrap; }

    /* ---- The map ---- */
    .map { margin-bottom: 3rem; }
    .legend {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      padding-bottom: 0.9rem;
      margin-bottom: 0.4rem;
      border-bottom: 1px solid var(--line);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }
    .key { display: inline-flex; align-items: center; gap: 0.5rem; }
    .legend-meta { margin-left: auto; }
    .dot {
      width: 11px; height: 11px; border-radius: 50%;
      flex: 0 0 auto; display: inline-block;
    }
    .dot-live { background: var(--accent); }
    .dot-series { background: var(--paper); border: 3px solid var(--accent); }
    .dot-planned { background: transparent; border: 1.5px dashed var(--ink-faint); }

    /* trunk line */
    .line {
      position: relative;
      list-style: none;
      margin: 0;
      padding: 0;
      --trunk: 1.4rem;   /* x of the trunk line */
    }
    .line::before {
      content: '';
      position: absolute;
      top: 1.6rem; bottom: 1.6rem;
      left: var(--trunk);
      width: 2px;
      transform: translateX(-1px);
      background: var(--line-strong);
    }
    /* signal pulse travelling the trunk */
    .line::after {
      content: '';
      position: absolute;
      top: 1.6rem; bottom: 1.6rem;
      left: var(--trunk);
      width: 2px;
      transform: translateX(-1px);
      background: linear-gradient(to bottom, transparent, var(--accent), transparent);
      background-size: 100% 26%;
      background-repeat: no-repeat;
      background-position: 0 -30%;
      opacity: 0.85;
      animation: signal 4.5s linear infinite;
      pointer-events: none;
    }
    @keyframes signal { to { background-position: 0 130%; } }

    .station { position: relative; border-bottom: 1px solid var(--line); }
    .station:last-child { border-bottom: none; }

    .station-row {
      display: grid;
      grid-template-columns: 2.8rem minmax(0, 1fr) auto;
      align-items: start;
      gap: 0.4rem 1.2rem;
      padding: 1.3rem 0.25rem;
      text-decoration: none;
      color: inherit;
    }
    a.station-row, .series > summary.station-row { transition: background 0.15s var(--ease-out); cursor: pointer; }
    a.station-row:hover, .series > summary:hover { background: var(--paper-raised); }
    .series > summary { list-style: none; }
    .series > summary::-webkit-details-marker { display: none; }
    .series > summary:focus-visible { outline: 2px solid var(--color-focus); outline-offset: -2px; }

    /* node dot sits on the trunk */
    .node { display: grid; place-items: center; padding-top: 0.35rem; }
    .station-row .dot { width: 15px; height: 15px; box-shadow: 0 0 0 5px var(--paper); }
    .station-row .dot-series { width: 15px; height: 15px; }
    .station-live:hover .dot-live,
    a.station-row:focus-visible .dot-live { transform: scale(1.25); transition: transform 0.15s var(--ease-out); }

    .station-body { min-width: 0; display: flex; flex-direction: column; gap: 0.3rem; }
    .station-coord {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .station-planned .station-coord { color: var(--ink-faint); }
    .station-title {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 1.6rem;
      line-height: 1.12;
      letter-spacing: -0.02em;
      color: var(--ink);
    }
    .station-sub { color: var(--ink-soft); font-size: 1rem; line-height: 1.45; max-width: 48ch; }

    .station-end {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      justify-self: end;
      padding-top: 0.5rem;
      white-space: nowrap;
    }
    .station-rt, .station-open {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      color: var(--ink-faint);
    }
    .station-open { color: var(--accent); text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.66rem; }
    .go { color: var(--accent); font-size: 1.15rem; transition: transform 0.15s var(--ease-out); }
    a.station-row:hover .go { transform: translateX(4px); }
    .chev { color: var(--accent); display: grid; place-items: center; transition: transform 0.2s var(--ease-out); }
    .chev svg { fill: none; stroke: currentColor; stroke-width: 2; }
    .series[open] > summary .chev { transform: rotate(90deg); }
    .station-planned { opacity: 0.6; }

    /* ---- Branch (series parts) ---- */
    .branch {
      position: relative;
      list-style: none;
      margin: 0 0 0.6rem;
      padding: 0.2rem 0 0.4rem;
      --twig: 3.4rem;
    }
    .branch::before {
      content: '';
      position: absolute;
      top: 0; bottom: 1rem;
      left: var(--twig);
      width: 2px;
      transform: translateX(-1px);
      background: var(--line);
    }
    .stop > a {
      display: grid;
      grid-template-columns: 4.8rem minmax(0, 1fr) auto auto;
      align-items: center;
      gap: 0.9rem;
      padding: 0.5rem 0.25rem;
      text-decoration: none;
      color: inherit;
      transition: background 0.12s var(--ease-out);
    }
    .stop > a:hover { background: var(--paper-raised); }
    .stop-node { display: grid; place-items: center; }
    .stop-dot {
      display: grid; place-items: center;
      width: 1.7rem; height: 1.7rem;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      color: var(--accent);
      background: var(--paper);
      border: 1.5px solid var(--accent-line);
      border-radius: 50%;
      box-shadow: 0 0 0 4px var(--paper);
    }
    .stop-cover .stop-dot { border-style: dashed; color: var(--accent); }
    .stop-title { min-width: 0; font-size: 1.02rem; color: var(--ink); }
    .stop-cover .stop-title { color: var(--ink-soft); font-style: italic; }
    .stop-rt { font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-faint); white-space: nowrap; }
    .stop .go { font-size: 1rem; }
    .stop > a:hover .go { transform: translateX(3px); }

    @media (max-width: 40rem) {
      .station-row { grid-template-columns: 2.4rem minmax(0, 1fr); gap: 0.3rem 0.9rem; }
      .station-title { font-size: 1.35rem; }
      .station-end { grid-column: 2; justify-self: start; padding-top: 0.5rem; }
      .line { --trunk: 1.2rem; }
      .branch { --twig: 3rem; }
      .stop > a { grid-template-columns: 4rem minmax(0, 1fr) auto; }
      .stop .go { display: none; }
      .legend-meta { margin-left: 0; flex-basis: 100%; }
    }
  </style>
</BaseLayout>
