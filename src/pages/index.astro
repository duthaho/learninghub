---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;

// Topics not written yet — shown as "coming soon" so the grid feels alive.
const upcoming = [
  { title: 'MySQL', subtitle: 'Indexes, transactions & the query planner', accent: '#00758f' },
  { title: 'Elasticsearch', subtitle: 'Inverted indexes, relevance & aggregations', accent: '#0b7285' },
];
---

<BaseLayout
  title="learninghub — backend systems, understood not memorised"
  description="In-depth, illustrated deep-dives on the backend systems every engineer leans on — Redis, MySQL, Elasticsearch and more. Written in public from real study notes."
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Deep-dives on the systems you actually use</p>
      <h1>
        Backend systems,<br />
        <em>understood</em> — not memorised.
      </h1>
      <p class="lede">
        I learn one system at a time, to the point where I can make design
        decisions and read other people's code. These are those notes, rewritten
        as illustrated deep-dives — mental models first, gotchas included, no
        hand-waving.
      </p>
      <div class="cta">
        <a class="btn" href="#topics">Browse topics ↓</a>
        <a class="ghost" href={`${base}about/`}>How this works →</a>
      </div>

      <ul class="principles" role="list">
        <li><span aria-hidden="true">◆</span> Mental model first</li>
        <li><span aria-hidden="true">◆</span> Taught to a rubric</li>
        <li><span aria-hidden="true">◆</span> Real gotchas, not trivia</li>
      </ul>
    </div>
  </section>

  <section id="topics" class="topics">
    <div class="wrap">
      <div class="section-head">
        <h2>Topics</h2>
        <p>{articles.length} live · {upcoming.length} in progress</p>
      </div>

      <ul class="grid" role="list">
        {articles.map((a, i) => (
          <li class="card" style={`--accent:${a.data.accent}`}>
            <a href={`${base}${a.id}/`}>
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <div class="card-top">
                <span class="tag">{a.data.level}</span>
                <span class="rt">{a.data.readingTime}</span>
              </div>
              <h3>{a.data.title}</h3>
              <p class="sub">{a.data.subtitle}</p>
              <p class="desc">{a.data.description}</p>
              <span class="more">Read the deep-dive →</span>
            </a>
          </li>
        ))}

        {upcoming.map((u, i) => (
          <li class="card card-soon" style={`--accent:${u.accent}`}>
            <span class="idx">{String(articles.length + i + 1).padStart(2, '0')}</span>
            <div class="card-top">
              <span class="tag tag-soon">Coming soon</span>
            </div>
            <h3>{u.title}</h3>
            <p class="sub">{u.subtitle}</p>
            <span class="more soon">In the writing queue</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <style>
    .hero { padding: clamp(3rem, 9vw, 6.5rem) 0 clamp(2.5rem, 6vw, 4rem); }
    .hero h1 {
      font-size: clamp(2.6rem, 8vw, 5rem);
      margin: 1.2rem 0 0;
      max-width: 16ch;
    }
    .hero h1 em { font-style: italic; color: var(--accent); }
    .lede {
      max-width: 40rem;
      font-size: clamp(1.1rem, 2.5vw, 1.3rem);
      line-height: 1.6;
      color: var(--ink-soft);
      margin: 1.6rem 0 2.2rem;
    }
    .cta { display: flex; gap: 1.4rem; align-items: center; flex-wrap: wrap; }
    .ghost { color: var(--ink-soft); font-weight: 500; text-decoration: none; }
    .ghost:hover { color: var(--accent-ink); }

    .principles {
      list-style: none;
      margin: 2.6rem 0 0;
      padding: 1.4rem 0 0;
      border-top: 1px solid var(--line);
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem 2rem;
      font-size: 0.92rem;
      color: var(--ink-soft);
    }
    .principles li { display: flex; align-items: center; gap: 0.5rem; }
    .principles span { color: var(--accent); font-size: 0.7rem; }

    .section-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.8rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--line);
    }
    .section-head h2 { font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 0; }
    .section-head p { color: var(--ink-faint); margin: 0; font-size: 0.9rem; font-family: var(--mono); }

    .grid {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
      gap: 1.4rem;
    }
    .card {
      position: relative;
      background: var(--paper-raised);
      border: 1px solid var(--line);
      border-radius: 16px;
      overflow: hidden;
      transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }
    /* accent bar along the top edge */
    .card::before {
      content: '';
      position: absolute;
      inset: 0 0 auto 0;
      height: 3px;
      background: var(--accent);
      opacity: 0.85;
    }
    .card:hover {
      transform: translateY(-4px);
      border-color: var(--accent-line);
      box-shadow: 0 20px 44px -26px color-mix(in srgb, var(--accent) 60%, transparent);
    }
    .card > a,
    .card.card-soon { display: block; padding: 1.6rem; text-decoration: none; color: inherit; }

    .idx {
      position: absolute;
      top: 1.2rem;
      right: 1.3rem;
      font-family: var(--serif);
      font-size: 1.1rem;
      color: var(--ink-faint);
      opacity: 0.5;
    }
    .card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      margin-bottom: 1.1rem;
      padding-right: 2rem;
    }
    .rt { font-family: var(--mono); font-size: 0.7rem; color: var(--ink-faint); }
    .card h3 {
      font-size: 1.55rem;
      margin: 0 0 0.3rem;
    }
    .card .sub {
      font-family: var(--serif);
      font-style: italic;
      color: var(--accent-ink);
      margin: 0 0 0.8rem;
      font-size: 1rem;
      line-height: 1.35;
    }
    .card .desc { color: var(--ink-soft); font-size: 0.95rem; margin: 0 0 1.2rem; }
    .more { font-weight: 500; font-size: 0.9rem; color: var(--accent-ink); }

    /* Coming-soon variant */
    .card-soon { opacity: 0.82; }
    .card-soon::before { opacity: 0.4; }
    .card-soon:hover { transform: none; box-shadow: none; border-color: var(--line); }
    .tag-soon {
      color: var(--ink-faint);
      background: var(--paper-sunk);
      border-color: var(--line);
    }
    .more.soon { color: var(--ink-faint); font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.04em; }
  </style>
</BaseLayout>
