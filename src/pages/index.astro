---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;

// Collapse multi-part series (frontmatter `series`) into a single entry;
// standalone articles stay as their own row. `part: 0` is the series cover
// (the start-here guide), everything else is a numbered chapter.
const bySeries = new Map();
const standalone = [];
for (const a of articles) {
  if (a.data.series) {
    if (!bySeries.has(a.data.series)) bySeries.set(a.data.series, []);
    bySeries.get(a.data.series).push(a);
  } else {
    standalone.push(a);
  }
}

const entries = standalone.map((a) => ({ kind: 'article', order: a.data.order, article: a }));
for (const [name, parts] of bySeries) {
  parts.sort((x, y) => (x.data.part ?? 0) - (y.data.part ?? 0));
  const cover = parts.find((p) => (p.data.part ?? 0) === 0) ?? parts[0];
  const chapters = parts.filter((p) => p !== cover);
  entries.push({
    kind: 'series',
    order: Math.min(...parts.map((p) => p.data.order)),
    name,
    slug: name.toLowerCase(),
    cover,
    chapters,
    count: chapters.length,
  });
}
entries.sort((a, b) => a.order - b.order);

const upcoming = [
  { id: 'mysql', title: 'MySQL', subtitle: 'Indexes, transactions & the query planner' },
];

const num = (n) => String(n + 1).padStart(2, '0');
---

<BaseLayout
  title="learninghub — backend systems, understood not memorised"
  description="In-depth deep-dives on the backend systems every engineer leans on — Redis, MySQL, Elasticsearch and more. Written in public from real study notes."
>
  <section class="hero wrap">
    <p class="eyebrow">Deep-dives on the systems you actually use</p>
    <h1>Backend systems,<br />understood — <span class="accent">not memorised.</span></h1>
    <p class="lede">
      I learn one system at a time, to the point where I can make design
      decisions and read other people's code. These are those notes, rewritten
      as structured deep-dives — mental models first, gotchas included.
    </p>
    <div class="cta">
      <a class="btn" href="#topics">Browse the index</a>
      <a class="btn-ghost" href={`${base}about/`}>How this works</a>
    </div>
    <p class="marks">
      Mental model first
      <span aria-hidden="true">·</span> Taught to a rubric
      <span aria-hidden="true">·</span> Real gotchas, not trivia
    </p>
  </section>

  <section id="topics" class="topics wrap">
    <div class="contents-head">
      <h2>The index</h2>
      <span class="count">{entries.length} topics · {articles.length} articles · {upcoming.length} in progress</span>
    </div>

    <ol class="contents" role="list">
      {entries.map((e, i) => (
        e.kind === 'article' ? (
          <li class="entry">
            <a href={`${base}${e.article.id}/`}>
              <span class="idx" aria-hidden="true">{num(i)}</span>
              <span class="body">
                <span class="title">{e.article.data.title}</span>
                <span class="sub">{e.article.data.subtitle}</span>
              </span>
              <span class="end">
                <span class="kind">deep-dive</span>
                <span class="rt">{e.article.data.readingTime}</span>
                <span class="go" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ) : (
          <li class="entry entry-series">
            <details class="series">
              <summary>
                <span class="idx" aria-hidden="true">{num(i)}</span>
                <span class="body">
                  <span class="title">{e.name}
                    <span class="badge">{e.count}-part series</span>
                  </span>
                  <span class="sub">{e.cover.data.subtitle}</span>
                </span>
                <span class="end">
                  <span class="kind">series</span>
                  <span class="rt browse">Contents</span>
                  <span class="chev" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="15" height="15"><path d="M9 6l6 6-6 6"/></svg>
                  </span>
                </span>
              </summary>
              <ol class="parts" role="list">
                <li class="part part-cover">
                  <a href={`${base}${e.cover.id}/`}>
                    <span class="pnum" aria-hidden="true">✦</span>
                    <span class="ptitle">Start here — series guide</span>
                    <span class="rt">{e.cover.data.readingTime}</span>
                    <span class="go" aria-hidden="true">→</span>
                  </a>
                </li>
                {e.chapters.map((c) => (
                  <li class="part">
                    <a href={`${base}${c.id}/`}>
                      <span class="pnum">{String(c.data.part).padStart(2, '0')}</span>
                      <span class="ptitle">{c.data.title}</span>
                      <span class="rt">{c.data.readingTime}</span>
                      <span class="go" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          </li>
        )
      ))}
      {upcoming.map((u, i) => (
        <li class="entry entry-soon">
          <span class="idx" aria-hidden="true">{num(entries.length + i)}</span>
          <span class="body">
            <span class="title">{u.title} <span class="badge badge-soon">In progress</span></span>
            <span class="sub">{u.subtitle}</span>
          </span>
          <span class="end"><span class="rt">queued</span></span>
        </li>
      ))}
    </ol>
  </section>

  <style>
    .hero { padding: clamp(3.5rem, 9vw, 6rem) 0 clamp(2.5rem, 6vw, 4rem); }
    .hero h1 {
      font-size: var(--text-display, clamp(2.6rem, 5.2vw + 1rem, 4.6rem));
      line-height: 1.06;
      margin: 1rem 0 0;
      max-width: 16ch;
    }
    .hero h1 .accent { color: var(--accent); }
    .lede {
      max-width: 42rem;
      font-size: clamp(1.1rem, 2.2vw, 1.3rem);
      line-height: 1.62;
      color: var(--ink-soft);
      margin: 1.5rem 0 2rem;
    }
    .cta { display: flex; gap: 0.8rem; flex-wrap: wrap; }
    .marks {
      margin: 2.4rem 0 0;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }
    .marks span { color: var(--accent); margin: 0 0.5rem; }

    /* ---- The index / table of contents ---- */
    .topics { margin-bottom: 2rem; }
    .contents-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding-bottom: 0.6rem;
      border-bottom: 3px double var(--line-strong);
    }
    .contents-head h2 { font-size: 1.5rem; margin: 0; }
    .count {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }

    .contents { list-style: none; margin: 0; padding: 0; }
    .entry { border-bottom: 1px solid var(--line); }
    .entry > a,
    .series > summary,
    .entry-soon {
      display: grid;
      grid-template-columns: 2.6rem minmax(0, 1fr) auto;
      align-items: baseline;
      gap: 0.4rem 1.2rem;
      padding: 1.25rem 0.25rem 1.15rem;
      text-decoration: none;
      color: inherit;
    }
    .entry > a, .series > summary { transition: background 0.15s var(--ease-out); }
    .entry > a:hover, .series > summary:hover { background: var(--paper-sunk); }

    .idx {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      color: var(--accent);
      padding-top: 0.28rem;
    }
    .body { min-width: 0; display: flex; flex-direction: column; gap: 0.28rem; }
    .title {
      font-family: var(--font-display);
      font-weight: 560;
      font-size: 1.45rem;
      line-height: 1.15;
      letter-spacing: -0.015em;
      color: var(--ink);
      display: flex;
      align-items: baseline;
      gap: 0.7rem;
      flex-wrap: wrap;
    }
    .sub { color: var(--ink-soft); font-size: 1rem; line-height: 1.45; max-width: 46ch; }
    .badge {
      font-family: var(--font-mono);
      font-size: 0.6rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      padding: 0.14em 0;
      border-bottom: 1px solid var(--accent-line);
      align-self: center;
    }
    .badge-soon { color: var(--ink-faint); border-bottom-color: var(--line-strong); }

    .end {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      justify-self: end;
      padding-top: 0.3rem;
    }
    .kind {
      font-family: var(--font-mono);
      font-size: 0.62rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-faint);
    }
    .rt { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-faint); white-space: nowrap; }
    .go {
      color: var(--accent);
      font-size: 1.15rem;
      transition: transform 0.15s var(--ease-out);
    }
    .entry > a:hover .go { transform: translateX(4px); }

    .entry-soon { opacity: 0.62; }

    /* ---- Series (collapsible) ---- */
    .entry-series { padding: 0; }
    .series { width: 100%; }
    .series > summary { cursor: pointer; list-style: none; }
    .series > summary::-webkit-details-marker { display: none; }
    .series > summary:focus-visible { outline: 2px solid var(--color-focus); outline-offset: -2px; }
    .browse { color: var(--accent); }
    .chev { color: var(--accent); display: grid; place-items: center; transition: transform 0.2s var(--ease-out); }
    .chev svg { fill: none; stroke: currentColor; stroke-width: 2; }
    .series[open] > summary .chev { transform: rotate(90deg); }

    .parts { list-style: none; margin: 0 0 0.6rem; padding: 0; border-top: 1px solid var(--line); }
    .part > a {
      display: grid;
      grid-template-columns: 2.6rem minmax(0, 1fr) auto auto;
      align-items: baseline;
      gap: 0.9rem;
      padding: 0.7rem 0.25rem 0.7rem 3rem;
      text-decoration: none;
      color: inherit;
      transition: background 0.12s var(--ease-out);
    }
    .part + .part > a,
    .part > a { border-top: 1px solid var(--line); }
    .part:first-child > a { border-top: none; }
    .part > a:hover { background: var(--paper-sunk); }
    .pnum {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--accent);
    }
    .part-cover .pnum { color: var(--accent); }
    .ptitle { min-width: 0; font-size: 1.02rem; color: var(--ink); }
    .part-cover .ptitle { color: var(--ink-soft); font-style: italic; }
    .part .go { color: var(--accent); font-size: 1rem; transition: transform 0.15s var(--ease-out); }
    .part > a:hover .go { transform: translateX(3px); }

    @media (max-width: 40rem) {
      .entry > a, .series > summary, .entry-soon {
        grid-template-columns: 2rem minmax(0, 1fr);
        gap: 0.3rem 0.9rem;
      }
      .title { font-size: 1.25rem; }
      .end {
        grid-column: 2;
        justify-self: start;
        padding-top: 0.4rem;
      }
      .kind { display: none; }
      .part > a { grid-template-columns: 2rem minmax(0, 1fr) auto; padding-left: 2.2rem; }
      .part .go { display: none; }
    }
  </style>
</BaseLayout>
