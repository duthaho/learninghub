---
import BaseLayout from '../layouts/BaseLayout.astro';

const method = [
  { k: 'model', d: 'Mental model first — before any API, the one idea that makes the rest make sense.' },
  { k: 'rubric', d: 'Each section maps to a concrete "can you actually do this?" check, not just exposure.' },
  { k: 'gotchas', d: 'The Gotcha notes are real mistakes from my review queue — misconceptions that cost me a session to unlearn, so they cost you a minute.' },
  { k: 'verified', d: 'Version-specific facts are checked against current docs before publishing.' },
];
---

<BaseLayout
  title="About — learninghub"
  description="Why learninghub exists and how these deep-dives are written."
>
  <section class="about wrap">
    <p class="eyebrow">About</p>
    <h1>Learning in public, one system at a time.</h1>

    <div class="letter">
      <p class="intro">
        Every article here starts as a personal study log: a syllabus, a set of
        pass/fail checks, and a running list of the things I got <em>wrong</em> and
        had to relearn. When a topic clicks, I rewrite those notes as a deep-dive
        meant for someone standing where I was a few weeks ago.
      </p>

      <hr class="rule" />

      <h2>How each deep-dive is built</h2>
      <dl class="method">
        {method.map((m) => (
          <div class="method-row">
            <dt>{m.k}</dt>
            <dd>{m.d}</dd>
          </div>
        ))}
      </dl>

      <hr class="rule" />

      <p class="outro">
        The goal isn't a reference you skim — it's understanding you keep. If a
        section can't survive being explained back in your own words, it isn't done.
      </p>

      <p class="sign">— duthaho</p>
    </div>
  </section>

  <style>
    .about { max-width: 46rem; padding-top: 3rem; }
    .about h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.08; margin: 0.9rem 0 0; }
    .letter { margin-top: 2rem; font-size: 1.14rem; line-height: 1.72; }
    .intro { margin: 0; color: var(--ink); }
    .about em { color: var(--accent-ink); font-style: italic; }

    .rule { margin: 2.4rem 0; }
    .letter h2 { font-size: 1.5rem; margin: 0 0 1.4rem; }

    .method { margin: 0; display: flex; flex-direction: column; gap: 0; }
    .method-row {
      display: grid;
      grid-template-columns: 7rem 1fr;
      gap: 1.4rem;
      padding: 1rem 0;
      border-bottom: 1px solid var(--line);
    }
    .method-row:last-child { border-bottom: none; }
    .method dt {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--accent);
      padding-top: 0.35rem;
    }
    .method dd { margin: 0; color: var(--ink-soft); font-size: 1.02rem; line-height: 1.6; }

    .outro { color: var(--ink-soft); }
    .sign {
      margin: 1.6rem 0 0;
      font-family: var(--font-display);
      font-style: italic;
      font-size: 1.2rem;
      color: var(--ink);
    }

    @media (max-width: 34rem) {
      .method-row { grid-template-columns: 1fr; gap: 0.3rem; }
      .method dt { padding-top: 0; }
    }
  </style>
</BaseLayout>
