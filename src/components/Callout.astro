---
// Variants map to editorial roles:
//   gotcha  — a mistake worth remembering (drawn from real review-queue misses)
//   insight — the "aha" that makes a concept click
//   note    — a useful aside
interface Props {
  type?: 'gotcha' | 'insight' | 'note';
  title?: string;
}
const { type = 'note', title } = Astro.props;
const meta = {
  gotcha: { icon: '⚠', label: 'Gotcha' },
  insight: { icon: '✦', label: 'Insight' },
  note: { icon: '→', label: 'Note' },
}[type];
---

<aside class={`callout callout-${type}`}>
  <p class="callout-label">
    <span class="callout-icon" aria-hidden="true">{meta.icon}</span>
    {title ?? meta.label}
  </p>
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    margin: 1.9rem 0;
    padding: 0.2rem 0 0.2rem 1.3rem;
    border-left: 3px solid var(--tone);
  }
  .callout-gotcha  { --tone: oklch(58% 0.15 45); }
  .callout-insight { --tone: var(--accent); }
  .callout-note    { --tone: oklch(52% 0.09 200); }
  :root[data-theme='dark'] .callout-gotcha { --tone: oklch(74% 0.14 55); }
  :root[data-theme='dark'] .callout-note   { --tone: oklch(72% 0.10 200); }

  .callout-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tone);
  }
  .callout-icon { font-size: 0.85rem; }
  .callout-body :global(p) { margin: 0.4rem 0; }
  .callout-body :global(p:last-child) { margin-bottom: 0; }
  .callout-body :global(p:first-child) { margin-top: 0; }
</style>
