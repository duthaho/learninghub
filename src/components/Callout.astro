---
// Variants map to editorial roles:
//   gotcha  — a mistake worth remembering (drawn from real review-queue misses)
//   insight — the "aha" that makes a concept click
//   note    — a useful aside
interface Props {
  type?: 'gotcha' | 'insight' | 'note';
  title?: string;
}
const { type = 'note', title } = Astro.props;
const meta = {
  gotcha: { icon: '⚠', label: 'Gotcha' },
  insight: { icon: '✦', label: 'Insight' },
  note: { icon: '→', label: 'Note' },
}[type];
---

<aside class={`callout callout-${type}`}>
  <div class="callout-head">
    <span class="callout-icon" aria-hidden="true">{meta.icon}</span>
    <span class="callout-label">{title ?? meta.label}</span>
  </div>
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    margin: 1.8rem 0;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--paper-raised);
    overflow: hidden;
  }
  .callout-gotcha  { --tone: #c2410c; --tone-wash: color-mix(in srgb, #c2410c 8%, var(--paper-raised)); }
  .callout-insight { --tone: var(--accent); --tone-wash: var(--accent-wash); }
  .callout-note    { --tone: #0f766e; --tone-wash: color-mix(in srgb, #0f766e 8%, var(--paper-raised)); }

  .callout-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    background: var(--tone-wash);
    border-bottom: 1px solid var(--line);
    border-left: 3px solid var(--tone);
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tone);
  }
  .callout-icon { font-size: 0.9rem; }
  .callout-body {
    padding: 0.9rem 1.1rem;
    border-left: 3px solid var(--tone);
  }
  .callout-body :global(p) { margin: 0.5rem 0; }
  .callout-body :global(p:last-child) { margin-bottom: 0; }
  .callout-body :global(p:first-child) { margin-top: 0; }
</style>
