---
import { support, supportUrl } from '../site.config';
interface Props { support?: boolean }
const { support: showSupport = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="colophon">
  <hr class="rule" />
  <div class="wrap inner">
    <span class="logo">learning<span>hub</span></span>
    <nav class="links" aria-label="Footer">
      <a href={`${base}#map`}>Map</a>
      <a href={`${base}about/`}>About</a>
      <a href="https://github.com/duthaho/learninghub" target="_blank" rel="noopener noreferrer">GitHub</a>
      {support.enabled && showSupport && (
        <a href={supportUrl} target="_blank" rel="noopener noreferrer">Coffee</a>
      )}
    </nav>
    <span class="copy">© {year} · duthaho</span>
  </div>
</footer>

<style>
  .colophon { margin-top: 3.5rem; }
  .rule { margin: 0; }
  .inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    padding: 1.1rem 0;
  }
  .logo {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .logo span { color: var(--accent); }

  .links { display: flex; flex-wrap: wrap; gap: 1.1rem; }
  .links a {
    color: var(--ink-soft);
    font-size: 0.9rem;
    border-bottom: 1px solid transparent;
    transition: color 0.15s var(--ease-out), border-color 0.15s var(--ease-out);
  }
  .links a:hover { color: var(--accent-ink); border-bottom-color: var(--accent); }

  .copy {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  @media (max-width: 40rem) {
    .copy { margin-left: 0; flex-basis: 100%; }
  }
</style>
