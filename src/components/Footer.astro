---
import { support, supportUrl } from '../site.config';
interface Props { support?: boolean }
const { support: showSupport = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="colophon">
  <hr class="rule-double" />
  <div class="wrap inner">
    <div class="mark">
      <span class="logo">learning<span>hub</span></span>
      <p class="note">
        Written from real study notes, one backend system at a time.
        Set in Fraunces &amp; Source&nbsp;Serif&nbsp;4.
      </p>
    </div>

    <nav class="links" aria-label="Footer">
      <span class="lbl">Index</span>
      <a href={`${base}#topics`}>Topics</a>
      <a href={`${base}about/`}>About</a>
      <a href="https://github.com/duthaho/learninghub" target="_blank" rel="noopener noreferrer">GitHub</a>
      {support.enabled && showSupport && (
        <a href={supportUrl} target="_blank" rel="noopener noreferrer">Buy me a coffee</a>
      )}
    </nav>
  </div>
  <div class="wrap base">
    <span>© {year} learninghub</span>
    <span>duthaho · learning in public</span>
  </div>
</footer>

<style>
  .colophon { margin-top: 5rem; }
  .rule-double { margin: 0; }
  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 1.5rem 3rem;
    padding: 2rem 0 1.4rem;
  }
  .logo {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .logo span { color: var(--accent); }
  .note {
    margin: 0.5rem 0 0;
    max-width: 32ch;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .links { display: flex; flex-direction: column; gap: 0.55rem; align-items: start; }
  .lbl {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.15rem;
  }
  .links a {
    color: var(--ink-soft);
    font-size: 0.95rem;
    border-bottom: 1px solid transparent;
    transition: color 0.15s var(--ease-out), border-color 0.15s var(--ease-out);
  }
  .links a:hover { color: var(--accent-ink); border-bottom-color: var(--accent); }

  .base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.9rem 0 1.6rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  @media (max-width: 40rem) {
    .inner { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
