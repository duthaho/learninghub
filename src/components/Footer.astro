---
import { support, supportUrl } from '../site.config';
interface Props { support?: boolean }
const { support: showSupport = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap inner">
    <span class="copy">© {year} <b>learning<span>hub</span></b></span>
    <nav class="links" aria-label="Footer">
      <a href={`${base}#topics`}>Topics</a>
      <a href={`${base}about/`}>About</a>
      <a href="https://github.com/duthaho/learninghub" target="_blank" rel="noopener noreferrer">GitHub</a>
      {support.enabled && showSupport && (
        <a href={supportUrl} target="_blank" rel="noopener noreferrer">☕ Coffee</a>
      )}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--line);
    background: var(--paper-raised);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1.4rem 0;
  }
  .copy { font-family: var(--mono); font-size: 0.8rem; color: var(--ink-faint); }
  .copy b { font-weight: 700; color: var(--ink-soft); }
  .copy span { color: var(--accent); }
  .links { display: flex; gap: 1.3rem; }
  .links a { color: var(--ink-soft); font-size: 0.88rem; font-weight: 500; }
  .links a:hover { color: var(--accent-ink); }
</style>
