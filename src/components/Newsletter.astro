---
import { newsletter, subscribeUrl } from '../site.config';

interface Props {
  // 'card' — sidebar width; 'wide' — homepage band (roomier, side-by-side)
  variant?: 'card' | 'wide';
}
const { variant = 'card' } = Astro.props;
---

{newsletter.enabled && (
  <section class={`nl nl-${variant}`}>
    <div class="nl-copy">
      <p class="side-label">Newsletter · Substack</p>
      <p class="nl-title">{newsletter.title}</p>
      <p class="nl-blurb">{newsletter.blurb}</p>
    </div>
    <form
      class="nl-form"
      action={subscribeUrl}
      method="get"
      target="_blank"
      rel="noopener"
      data-subscribe={subscribeUrl}
    >
      <label class="sr-only" for={`nl-email-${variant}`}>Email address</label>
      <input
        id={`nl-email-${variant}`}
        class="nl-input"
        type="email"
        name="email"
        inputmode="email"
        autocomplete="email"
        placeholder="you@example.com"
        required
      />
      <button class="btn nl-btn" type="submit">{newsletter.cta}</button>
    </form>
  </section>
)}

<script>
  // Open Substack's subscribe page with the email prefilled, without losing
  // the current article (new tab). Falls back to normal GET if JS is off.
  document.querySelectorAll<HTMLFormElement>('form[data-subscribe]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const base = form.dataset.subscribe || '';
      const email = (form.querySelector('input[name="email"]') as HTMLInputElement)?.value.trim();
      const url = email ? `${base}?email=${encodeURIComponent(email)}` : base;
      window.open(url, '_blank', 'noopener');
    });
  });
</script>

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  .side-label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 0.7rem;
  }
  .nl-title { font-family: var(--font-display); font-weight: 560; font-size: 1.12rem; margin: 0 0 0.4rem; color: var(--ink); }
  .nl-blurb { margin: 0 0 1rem; font-size: 0.92rem; line-height: 1.55; color: var(--ink-soft); }

  .nl-form { display: flex; flex-direction: column; gap: 0.5rem; }
  .nl-input {
    width: 100%;
    padding: 0.6rem 0.7rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    transition: border-color 0.15s var(--ease-out);
  }
  .nl-input::placeholder { color: var(--ink-faint); }
  .nl-input:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-wash); }
  .nl-btn { width: 100%; }

  /* Wide variant (homepage band): copy left, form right */
  .nl-wide { display: flex; gap: 1.5rem 2.5rem; align-items: center; flex-wrap: wrap; }
  .nl-wide .nl-copy { flex: 1 1 20rem; }
  .nl-wide .nl-blurb { margin-bottom: 0; }
  .nl-wide .nl-form { flex: 1 1 18rem; flex-direction: row; }
  .nl-wide .nl-btn { width: auto; white-space: nowrap; }
  @media (max-width: 34rem) {
    .nl-wide .nl-form { flex-direction: column; }
    .nl-wide .nl-btn { width: 100%; }
  }
</style>
