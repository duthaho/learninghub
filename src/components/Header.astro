---
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const repo = 'https://github.com/duthaho/learninghub';
const onAbout = path.startsWith(`${base}about`);
---

<header class="masthead">
  <div class="wrap bar">
    <a class="brand" href={base} aria-label="learninghub home">
      <span class="mark">
        <span class="node-dot" aria-hidden="true"></span>
        <span class="logo">learning<span class="logo-accent">hub</span></span>
      </span>
      <span class="tagline">a map of backend systems</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <a class="lnk" href={`${base}#map`}>Map</a>
      <a class="lnk" class:list={[{ active: onAbout }]} href={`${base}about/`}>About</a>
      <a class="lnk" href={repo} target="_blank" rel="noopener noreferrer">GitHub</a>
      <button id="theme-toggle" class="toggle" type="button" aria-label="Toggle colour theme" title="Toggle light / dark">
        <svg class="i-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor" stroke="none"/><g stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><line x1="12" y1="2.5" x2="12" y2="5"/><line x1="12" y1="19" x2="12" y2="21.5"/><line x1="2.5" y1="12" x2="5" y2="12"/><line x1="19" y1="12" x2="21.5" y2="12"/><line x1="5.1" y1="5.1" x2="6.8" y2="6.8"/><line x1="17.2" y1="17.2" x2="18.9" y2="18.9"/><line x1="18.9" y1="5.1" x2="17.2" y2="6.8"/><line x1="6.8" y1="17.2" x2="5.1" y2="18.9"/></g></svg>
        <svg class="i-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="currentColor" stroke="none"/></svg>
      </button>
    </nav>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
</script>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 200;
    background: color-mix(in oklch, var(--paper) 88%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 3px double var(--line-strong);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; min-height: 4rem; gap: 1rem; padding: 0.5rem 0; }

  .brand { text-decoration: none; display: flex; flex-direction: column; gap: 0.1rem; line-height: 1.05; }
  .mark { display: inline-flex; align-items: center; gap: 0.5rem; }
  .node-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-wash);
    flex: 0 0 auto;
  }
  .logo {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .logo-accent { color: var(--accent); }
  .tagline {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .nav { display: flex; align-items: center; gap: 1.4rem; }
  .lnk {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding: 0.2rem 0;
    border-bottom: 1px solid transparent;
    transition: color 0.15s var(--ease-out), border-color 0.15s var(--ease-out);
  }
  .lnk:hover { color: var(--accent-ink); border-bottom-color: var(--accent); }
  .lnk.active { color: var(--accent-ink); border-bottom-color: var(--accent); }

  .toggle {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    color: var(--ink-soft);
    background: transparent;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: color 0.15s var(--ease-out), border-color 0.15s var(--ease-out);
  }
  .toggle:hover { color: var(--accent-ink); border-color: var(--accent); }
  .toggle svg { display: block; }
  .i-sun { display: none; }
  :root[data-theme='dark'] .i-sun { display: block; }
  :root[data-theme='dark'] .i-moon { display: none; }

  @media (max-width: 40rem) {
    .tagline { display: none; }
    .nav { gap: 1rem; }
    .lnk { font-size: 0.68rem; letter-spacing: 0.08em; }
  }
</style>
