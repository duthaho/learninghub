---
// Floating "scroll to top" pill — appears after scrolling down, like skillsmp.
---
<button id="scroll-top" class="scroll-top" type="button" aria-label="Scroll to top" hidden>
  <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
    <path d="M12 19V5M6 11l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span>Scroll to top</span>
</button>

<script>
  const btn = document.getElementById('scroll-top');
  if (btn) {
    const toggle = () => {
      const show = window.scrollY > 600;
      btn.hidden = !show;
      btn.classList.toggle('visible', show);
    };
    document.addEventListener('scroll', toggle, { passive: true });
    toggle();
    btn.addEventListener('click', () => {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>

<style>
  .scroll-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 200;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    background: color-mix(in oklch, var(--paper) 92%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s var(--ease-out), transform 0.2s var(--ease-out), border-color 0.15s var(--ease-out), color 0.15s var(--ease-out);
  }
  .scroll-top.visible { opacity: 1; transform: translateY(0); }
  .scroll-top svg { color: var(--accent); }
  .scroll-top:hover { border-color: var(--accent); color: var(--accent-ink); }

  @media (max-width: 34rem) {
    .scroll-top span { display: none; }
    .scroll-top { padding: 0.6rem; }
  }
</style>
