---
// Floating "scroll to top" pill — appears after scrolling down, like skillsmp.
---
<button id="scroll-top" class="scroll-top" type="button" aria-label="Scroll to top" hidden>
  <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
    <path d="M12 19V5M6 11l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span>Scroll to top</span>
</button>

<script>
  const btn = document.getElementById('scroll-top');
  if (btn) {
    const toggle = () => {
      const show = window.scrollY > 600;
      btn.hidden = !show;
      btn.classList.toggle('visible', show);
    };
    document.addEventListener('scroll', toggle, { passive: true });
    toggle();
    btn.addEventListener('click', () => {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>

<style>
  .scroll-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 45;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.9rem;
    font-family: var(--sans);
    font-size: 0.82rem;
    font-weight: 550;
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    box-shadow: 0 8px 24px -10px rgba(var(--shadow), 0.25);
    cursor: pointer;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .scroll-top.visible { opacity: 1; transform: translateY(0); }
  .scroll-top svg { color: var(--accent); }
  .scroll-top:hover { border-color: var(--accent-line); color: var(--accent-ink); }

  @media (max-width: 34rem) {
    .scroll-top span { display: none; }
    .scroll-top { padding: 0.6rem; }
  }
</style>
