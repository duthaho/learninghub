---
import Panel from './Panel.astro';
import { support, supportUrl } from '../site.config';

interface Props {
  // 'card'   — titled panel with blurb + button (article sidebar)
  // 'inline' — a single compact button (footer)
  variant?: 'card' | 'inline';
}
const { variant = 'card' } = Astro.props;
---

{support.enabled && (
  variant === 'inline' ? (
    <a class="bmc-inline" href={supportUrl} target="_blank" rel="noopener noreferrer">
      <span aria-hidden="true">☕</span> {support.label}
    </a>
  ) : (
    <Panel title="Support the work" meta="☕">
      <p class="blurb">{support.blurb}</p>
      <a class="btn support-btn" href={supportUrl} target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">☕</span> {support.label}
      </a>
    </Panel>
  )
)}

<style>
  .blurb { margin: 0 0 1rem; font-size: 0.9rem; color: var(--ink-soft); line-height: 1.55; }
  .support-btn { width: 100%; }

  .bmc-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: 0.88rem;
    font-weight: 550;
    text-decoration: none;
    color: #1a1608;
    background: #ffdd00;
    border: 1px solid color-mix(in srgb, #ffdd00 70%, #b58b00);
    padding: 0.5em 0.95em;
    border-radius: 9px;
    transition: transform 0.15s ease;
  }
  .bmc-inline:hover { transform: translateY(-1px); color: #1a1608; }
</style>
