---
import { support, supportUrl } from '../site.config';

interface Props {
  // 'card'   — labelled block with blurb + button (article sidebar)
  // 'inline' — a single compact link (footer)
  variant?: 'card' | 'inline';
}
const { variant = 'card' } = Astro.props;
---

{support.enabled && (
  variant === 'inline' ? (
    <a class="bmc-inline" href={supportUrl} target="_blank" rel="noopener noreferrer">
      <span aria-hidden="true">☕</span> {support.label}
    </a>
  ) : (
    <section class="support">
      <p class="side-label">Support the work</p>
      <p class="blurb">{support.blurb}</p>
      <a class="btn-ghost support-btn" href={supportUrl} target="_blank" rel="noopener noreferrer">
        <span aria-hidden="true">☕</span> {support.label}
      </a>
    </section>
  )
)}

<style>
  .side-label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 0.7rem;
  }
  .blurb { margin: 0 0 1rem; font-size: 0.92rem; color: var(--ink-soft); line-height: 1.55; }
  .support-btn { width: 100%; }

  .bmc-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: 0.95rem;
    color: var(--ink-soft);
    border-bottom: 1px solid transparent;
    transition: color 0.15s var(--ease-out), border-color 0.15s var(--ease-out);
  }
  .bmc-inline:hover { color: var(--accent-ink); border-bottom-color: var(--accent); }
</style>
